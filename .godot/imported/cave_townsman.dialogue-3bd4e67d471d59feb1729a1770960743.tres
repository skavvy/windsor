"2": {
&"character": "???",
&"id": "2",
&"next_id": "3",
&"static_id": "",
&"text": "What's some high-horse-riding girl like you doing here?",
&"type": "dialogue"
},
"3": {
&"id": "3",
&"next_id": "4",
&"responses": PackedStringArray("3", "8"),
&"static_id": "",
&"text": "I fell.",
&"type": "response"
},
"4": {
&"character": "???",
&"id": "4",
&"next_id": "5",
&"static_id": "",
&"text": "[wait=0.5]",
&"type": "dialogue"
},
"5": {
&"character": "???",
&"id": "5",
&"next_id": "6",
&"static_id": "",
&"text": "[wave]Really[/wave], now?",
&"type": "dialogue"
},
"6": {
&"character": "???",
&"id": "6",
&"next_id": "7",
&"static_id": "",
&"text": "I don't think I believe that.",
&"type": "dialogue"
},
"7": {
&"character": "???",
&"id": "7",
&"next_id": "11",
&"static_id": "",
&"text": "Now find your way out, [shake rate=20 level=10]royal scum[/shake].",
&"type": "dialogue"
},
"8": {
&"id": "8",
&"next_id": "9",
&"static_id": "",
&"text": "I am on a crusade, of sorts.",
&"type": "response"
},
"9": {
&"character": "???",
&"id": "9",
&"next_id": "10",
&"static_id": "",
&"text": "We don't take [shake rate=20 level=10]too kindly[/shake] to your type around here.",
&"type": "dialogue"
}
